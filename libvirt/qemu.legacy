#!/usr/bin/env bash

# Give win11-starsector exclusive use of the six performance cores while it
# runs. Linux and the VM continue sharing the ten efficiency cores.

vm_name=${1:-}
operation=${2:-}
suboperation=${3:-}

[[ $vm_name == win11-starsector ]] || exit 0

set_cpus() {
  local unit=$1
  local cpus=$2

  if ! systemctl set-property --runtime "$unit" "AllowedCPUs=$cpus"; then
    logger -t win11-starsector-cpu "Could not set $unit AllowedCPUs=$cpus"
  fi
}

case "$operation/$suboperation" in
  prepare/begin)
    # Keep the VM's slice unrestricted, then move ordinary host work away
    # from CPUs 0-5 before QEMU creates its pinned vCPU threads.
    set_cpus machine.slice 0-15
    set_cpus system.slice 6-15
    set_cpus user.slice 6-15
    logger -t win11-starsector-cpu \
      'Reserved performance CPUs 0-5 for win11-starsector; sharing CPUs 6-15'
    ;;
  release/end)
    # An empty AllowedCPUs value restores the parent cgroup's full CPU set.
    set_cpus system.slice ''
    set_cpus user.slice ''
    set_cpus machine.slice ''
    logger -t win11-starsector-cpu 'Returned CPUs 0-15 to Linux'
    ;;
esac

exit 0
