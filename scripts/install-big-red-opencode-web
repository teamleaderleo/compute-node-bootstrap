#!/usr/bin/env bash
set -euo pipefail

mode=apply
operator_user=${SUDO_USER:-$(id -un)}
port=4096
https_port=443
unit_name=big-red-opencode-web.service
script_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
unit_source="$script_root/../systemd/$unit_name"
muse_model=opencode/muse-spark-1.3-contributor-free

usage() {
  cat <<'USAGE'
Usage: install-big-red-opencode-web [--plan|--verify-only] [--operator-user USER]

Install or verify the loopback-only OpenCode Web user service and its private
Tailscale Serve HTTPS route. The script never prints the server password.
USAGE
}

while (($#)); do
  case "$1" in
    --plan) mode=plan; shift ;;
    --verify-only) mode=verify; shift ;;
    --operator-user)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      operator_user=$2
      shift 2
      ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

passwd_row=$(getent passwd "$operator_user" || true)
operator_uid=$(cut -d: -f3 <<<"$passwd_row")
operator_home=$(cut -d: -f6 <<<"$passwd_row")
[[ -n "$operator_uid" && -n "$operator_home" && -d "$operator_home" ]] || {
  printf 'error: operator user %s has no existing home directory\n' "$operator_user" >&2
  exit 1
}
[[ -f "$unit_source" && ! -L "$unit_source" ]] || {
  printf 'error: OpenCode Web unit source is missing or invalid\n' >&2
  exit 1
}

local_bin="$operator_home/.local/bin"
opencode="$local_bin/opencode"
projects_root="$operator_home/Projects"
credential_dir="$operator_home/.config/big-red-opencode-web"
password_file="$credential_dir/server-password"
unit_dir="$operator_home/.config/systemd/user"
unit_target="$unit_dir/$unit_name"
backend="http://127.0.0.1:$port"
health_url="$backend/global/health"

as_operator() {
  local runtime="/run/user/$operator_uid"
  if [[ $(id -un) == "$operator_user" ]]; then
    env HOME="$operator_home" USER="$operator_user" LOGNAME="$operator_user" \
      XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
      PATH="$local_bin:$operator_home/.opencode/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}" "$@"
  else
    command -v sudo >/dev/null || {
      printf 'error: sudo is required to act as operator user %s\n' "$operator_user" >&2
      return 1
    }
    sudo -u "$operator_user" env HOME="$operator_home" USER="$operator_user" LOGNAME="$operator_user" \
      XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
      PATH="$local_bin:$operator_home/.opencode/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}" "$@"
  fi
}

as_root() {
  if ((EUID == 0)); then
    "$@"
  else
    command -v sudo >/dev/null || {
      printf 'error: sudo is required to enable user lingering\n' >&2
      return 1
    }
    sudo "$@"
  fi
}

require_tools() {
  local tool
  for tool in bash cmp curl cut getent grep id install jq loginctl python3 sha256sum sleep ss systemctl tailscale tr wc; do
    command -v "$tool" >/dev/null || {
      printf 'error: required host tool is missing: %s\n' "$tool" >&2
      return 1
    }
  done
}

tailnet_dns_name() {
  as_operator tailscale status --json | jq -er '.Self.DNSName | select(type == "string" and length > 1) | rtrimstr(".")'
}

print_plan() {
  require_tools
  local dns_name
  dns_name=$(tailnet_dns_name)
  printf 'operator_user=%s\n' "$operator_user"
  printf 'opencode_launcher_relative=.local/bin/opencode\n'
  printf 'working_directory_relative=Projects\n'
  printf 'service_unit_relative=.config/systemd/user/%s\n' "$unit_name"
  printf 'credential_relative=.config/big-red-opencode-web/server-password\n'
  printf 'credential_mode=0600\n'
  printf 'local_bind=127.0.0.1:%s\n' "$port"
  printf 'tailscale_backend=%s\n' "$backend"
  printf 'tailscale_https_url=https://%s/\n' "$dns_name"
  printf 'muse_model=%s\n' "$muse_model"
  printf 'public_funnel=disabled\n'
}

ensure_password() {
  as_operator install -d -m 0700 "$credential_dir"
  as_operator python3 - "$password_file" <<'PY'
import os
import secrets
import stat
import sys

path = sys.argv[1]
created = False
flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
try:
    fd = os.open(path, flags)
except FileNotFoundError:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, (secrets.token_urlsafe(36) + "\n").encode("ascii"))
        os.fsync(fd)
    finally:
        os.close(fd)
    created = True
    fd = os.open(path, flags)

try:
    metadata = os.fstat(fd)
    value = os.read(fd, 256)
finally:
    os.close(fd)

if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != os.getuid()
    or metadata.st_nlink != 1
    or stat.S_IMODE(metadata.st_mode) != 0o600
    or len(value.rstrip(b"\n")) < 32
    or len(value) > 128
):
    raise SystemExit("OpenCode Web password file is not one private owner credential")
print("server_password_status=" + ("created" if created else "preserved"))
PY
}

install_unit() {
  as_operator install -d -m 0700 "$unit_dir"
  as_operator install -m 0644 "$unit_source" "$unit_target"
  printf 'service_unit_sha256=%s\n' "$(sha256sum "$unit_source" | cut -d' ' -f1)"
}

authenticated_get() {
  local url=$1
  {
    printf 'user = "opencode:'
    tr -d '\n' < "$password_file"
    printf '"\n'
  } | as_operator curl --config - --silent --show-error --fail --max-time 10 "$url"
}

verify_password() {
  as_operator python3 - "$password_file" <<'PY'
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    metadata = os.fstat(fd)
    value = os.read(fd, 256)
finally:
    os.close(fd)
assert stat.S_ISREG(metadata.st_mode)
assert metadata.st_uid == os.getuid()
assert metadata.st_nlink == 1
assert stat.S_IMODE(metadata.st_mode) == 0o600
assert 32 <= len(value.rstrip(b"\n")) <= 128
print("server_password=configured")
print("server_password_mode=0600")
PY
}

verify_http() {
  local unauthenticated health path files
  unauthenticated=$(as_operator curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "$health_url")
  [[ "$unauthenticated" == 401 ]] || {
    printf 'error: unauthenticated OpenCode health request returned HTTP %s\n' "$unauthenticated" >&2
    return 1
  }
  health=$(authenticated_get "$health_url")
  jq -e '.healthy == true and (.version | type == "string")' <<<"$health" >/dev/null
  path=$(authenticated_get "$backend/path")
  [[ $(jq -r '.worktree // .directory // empty' <<<"$path") == "$projects_root" ]] || {
    printf 'error: OpenCode Web is not rooted at the canonical Projects directory\n' >&2
    return 1
  }
  files=$(authenticated_get "$backend/file?path=.")
  jq -e 'any(.[]; .name == "compute-node-bootstrap") and any(.[]; .name == "leo-workspace")' <<<"$files" >/dev/null || {
    printf 'error: OpenCode Web cannot see the expected Big Red repositories\n' >&2
    return 1
  }
  printf 'opencode_web_health=healthy\n'
  printf 'opencode_web_projects=compute-node-bootstrap,leo-workspace\n'
}

verify_listener() {
  local listeners
  listeners=$(ss -ltnH "sport = :$port")
  [[ $(wc -l <<<"$listeners" | tr -d ' ') == 1 && "$listeners" == *"127.0.0.1:$port"* ]] || {
    printf 'error: OpenCode Web listener is not exactly loopback %s\n' "$port" >&2
    return 1
  }
  [[ "$listeners" != *"0.0.0.0:$port"* && "$listeners" != *"[::]:$port"* ]] || {
    printf 'error: OpenCode Web created a non-loopback listener\n' >&2
    return 1
  }
  printf 'opencode_web_listener=127.0.0.1:%s\n' "$port"
}

verify_serve() {
  local serve_json funnel_json dns_name
  serve_json=$(as_operator tailscale serve status --json)
  funnel_json=$(as_operator tailscale funnel status --json)
  python3 - "$backend" "$serve_json" "$funnel_json" <<'PY'
import json
import sys

backend = sys.argv[1]
serve = json.loads(sys.argv[2])
funnel = json.loads(sys.argv[3])

def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for key, item in value.items():
            yield from strings(key)
            yield from strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from strings(item)

if backend not in set(strings(serve)):
    raise SystemExit("Tailscale Serve does not target the OpenCode loopback backend")
if funnel not in ({}, None):
    raise SystemExit("Tailscale Funnel must remain disabled")
PY
  dns_name=$(tailnet_dns_name)
  printf 'tailscale_serve=active\n'
  printf 'tailscale_funnel=disabled\n'
  printf 'tailscale_https_url=https://%s/\n' "$dns_name"
}

verify() {
  require_tools
  [[ -x "$opencode" && ! -d "$opencode" ]] || {
    printf 'error: OpenCode is not installed at %s\n' "$opencode" >&2
    return 1
  }
  [[ -d "$projects_root" ]] || {
    printf 'error: canonical Projects directory is missing\n' >&2
    return 1
  }
  cmp -s "$unit_source" "$unit_target" || {
    printf 'error: installed OpenCode Web unit does not match the reviewed source\n' >&2
    return 1
  }
  [[ $(as_operator systemctl --user is-enabled "$unit_name") == enabled ]]
  [[ $(as_operator systemctl --user is-active "$unit_name") == active ]]
  [[ $(loginctl show-user "$operator_user" -p Linger --value) == yes ]]
  verify_password
  verify_listener
  verify_http
  verify_serve
  as_operator "$opencode" models opencode | grep -qx "$muse_model"
  printf 'user_service=enabled,active\n'
  printf 'user_linger=enabled\n'
  printf 'muse_model=%s\n' "$muse_model"
}

install_web() {
  print_plan
  ensure_password
  install_unit
  as_root loginctl enable-linger "$operator_user"
  as_operator systemctl --user daemon-reload
  as_operator systemctl --user enable "$unit_name"
  as_operator systemctl --user restart "$unit_name"
  local _
  for _ in {1..40}; do
    if [[ $(as_operator systemctl --user is-active "$unit_name" 2>/dev/null || true) == active ]] && \
      [[ $(as_operator curl --silent --output /dev/null --write-out '%{http_code}' --max-time 2 "$health_url" 2>/dev/null || true) == 401 ]]; then
      break
    fi
    sleep 0.25
  done
  as_operator tailscale serve --bg --yes --https="$https_port" "$backend"
  verify
}

case "$mode" in
  plan) print_plan ;;
  verify) verify ;;
  apply) install_web ;;
esac
