#!/usr/bin/env bash
set -euo pipefail

# Keep the remote host awake while allowing the high-resolution panel to sleep.
gsettings set org.gnome.settings-daemon.plugins.power ambient-enabled false
gsettings set org.gnome.settings-daemon.plugins.power idle-dim true
gsettings set org.gnome.settings-daemon.plugins.power idle-brightness 30
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout 0
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing'
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout 0
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing'
gsettings set org.gnome.desktop.session idle-delay 'uint32 600'
gsettings set org.gnome.desktop.screensaver lock-enabled false
gsettings set org.gnome.desktop.screensaver lock-delay 'uint32 0'

# GNOME search is for human files, not 30+ GiB of repositories, build trees,
# dependency caches, and language module stores. Code search belongs to rg and
# project-aware editors; keeping it out of LocalSearch avoids useless extractor
# churn and known MIME misclassification of files such as Go's *.mod.
gsettings set org.freedesktop.Tracker3.Miner.Files index-recursive-directories \
  "['&DESKTOP', '&DOCUMENTS', '&DOWNLOAD', '&MUSIC', '&PICTURES', '&VIDEOS']"

# Start this exact panel near 40% at each login. Local brightness keys remain
# free to change it afterward. Fail open if hardware/session identity drifts.
if command -v gdctl >/dev/null 2>&1 &&
   [[ $(cat /sys/class/backlight/intel_backlight/max_brightness 2>/dev/null || true) == 496 ]]; then
  for _attempt in {1..10}; do
    display_state=$(gdctl show 2>/dev/null || true)
    if grep -q 'Monitor eDP-1' <<<"${display_state}" &&
       gdctl prefs --monitor eDP-1 --backlight 200; then
      break
    fi
    sleep 1
  done
fi
