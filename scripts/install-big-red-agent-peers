#!/usr/bin/env bash
set -euo pipefail

mode=apply
operator_user=${SUDO_USER:-leo}
claude_installer_url=https://claude.ai/install.sh
antigravity_installer_url=https://antigravity.google/cli/install.sh
script_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
peer_source="$script_root/big-red-agent-peer"
claude_delegate_model='claude-opus-5'
claude_delegate_effort=high
antigravity_delegate_model=gemini-3.7-flash-high
antigravity_delegate_effort=high

usage() {
  cat <<'USAGE'
Usage: install-big-red-agent-peers [--plan|--verify-only] [--operator-user USER]

Install or verify the official user-scoped Claude Code stable channel,
Antigravity CLI, and the reviewed Big Red peer launcher. This script never
authenticates either provider and never reads provider credential stores.
USAGE
}

while (($#)); do
  case "$1" in
    --plan) mode=plan; shift ;;
    --verify-only) mode=verify; shift ;;
    --operator-user)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      operator_user=$2
      shift 2
      ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

operator_home=$(getent passwd "$operator_user" | cut -d: -f6 || true)
[[ -n "$operator_home" && -d "$operator_home" ]] || {
  printf 'error: operator user %s has no existing home directory\n' "$operator_user" >&2
  exit 1
}
[[ -f "$peer_source" && ! -L "$peer_source" ]] || {
  printf 'error: peer launcher source is missing or invalid: %s\n' "$peer_source" >&2
  exit 1
}

local_bin="$operator_home/.local/bin"
claude="$local_bin/claude"
antigravity="$local_bin/agy"
peer_launcher="$local_bin/big-red-agent-peer"
cache_root="$operator_home/.cache"

as_operator() {
  if [[ $(id -un) == "$operator_user" ]]; then
    env HOME="$operator_home" USER="$operator_user" LOGNAME="$operator_user" \
      PATH="$local_bin:${PATH:-/usr/local/bin:/usr/bin:/bin}" "$@"
  else
    command -v sudo >/dev/null || {
      printf 'error: sudo is required to act as operator user %s\n' "$operator_user" >&2
      return 1
    }
    sudo -u "$operator_user" env HOME="$operator_home" USER="$operator_user" LOGNAME="$operator_user" \
      PATH="$local_bin:${PATH:-/usr/local/bin:/usr/bin:/bin}" "$@"
  fi
}

require_tools() {
  local tool
  for tool in bash curl sha256sum mktemp getent readlink head awk grep install stat python3; do
    command -v "$tool" >/dev/null || {
      printf 'error: required host tool is missing: %s\n' "$tool" >&2
      return 1
    }
  done
}

print_plan() {
  require_tools
  printf 'operator_user=%s\n' "$operator_user"
  printf 'claude_channel=stable\n'
  printf 'claude_installer=%s\n' "$claude_installer_url"
  printf 'claude_launcher_relative=.local/bin/claude\n'
  printf 'claude_delegate_model=%s\n' "$claude_delegate_model"
  printf 'claude_delegate_effort=%s\n' "$claude_delegate_effort"
  printf 'antigravity_installer=%s\n' "$antigravity_installer_url"
  printf 'antigravity_launcher_relative=.local/bin/agy\n'
  printf 'antigravity_installer_flags=--skip-path --skip-aliases\n'
  printf 'antigravity_delegate_model=%s\n' "$antigravity_delegate_model"
  printf 'antigravity_delegate_effort=%s\n' "$antigravity_delegate_effort"
  printf 'peer_launcher_relative=.local/bin/big-red-agent-peer\n'
  printf 'peer_launcher_sha256=%s\n' "$(sha256sum "$peer_source" | awk '{print $1}')"
  printf 'peer_usage_ledger_relative=.local/state/big-red-agent-peer/usage.jsonl\n'
  printf 'delegated_agent_mode=full_unattended\n'
  printf 'provider_authentication=separate_interactive_step\n'
  printf 'credential_files_read=none\n'
}

verify_provider_launcher() {
  local label=$1 launcher=$2
  [[ -e "$launcher" || -L "$launcher" ]] || {
    printf 'error: %s launcher is missing: %s\n' "$label" "$launcher" >&2
    return 1
  }
  local resolved
  resolved=$(readlink -f "$launcher")
  [[ -n "$resolved" && -f "$resolved" && -x "$resolved" ]] || {
    printf 'error: %s launcher does not resolve to an executable regular file\n' "$label" >&2
    return 1
  }
  case "$resolved" in
    "$operator_home"/*) ;;
    *) printf 'error: %s launcher escapes the operator home: %s\n' "$label" "$resolved" >&2; return 1 ;;
  esac
}

verify_peer_launcher() {
  [[ -f "$peer_launcher" && ! -L "$peer_launcher" && -x "$peer_launcher" ]] || {
    printf 'error: managed peer launcher is missing or invalid\n' >&2
    return 1
  }
  local installed_sha source_sha
  installed_sha=$(sha256sum "$peer_launcher" | awk '{print $1}')
  source_sha=$(sha256sum "$peer_source" | awk '{print $1}')
  [[ "$installed_sha" == "$source_sha" ]] || {
    printf 'error: managed peer launcher does not match the reviewed checkout\n' >&2
    return 1
  }
  printf 'peer_launcher_sha256=%s\n' "$installed_sha"
}

verify() {
  require_tools
  verify_provider_launcher claude "$claude"
  verify_provider_launcher antigravity "$antigravity"
  verify_peer_launcher

  local claude_version antigravity_version claude_help antigravity_help
  claude_version=$(as_operator "$claude" --version | head -c 500)
  antigravity_version=$(as_operator "$antigravity" --version | head -c 500)
  [[ -n "$claude_version" && -n "$antigravity_version" ]] || {
    printf 'error: one provider CLI returned an empty version\n' >&2
    return 1
  }
  claude_help=$(as_operator "$claude" --help 2>&1)
  antigravity_help=$(as_operator "$antigravity" --help 2>&1)
  for flag in --dangerously-skip-permissions --model --effort --output-format; do
    grep -q -- "$flag" <<<"$claude_help" || {
      printf 'error: installed Claude Code lacks required %s support\n' "$flag" >&2
      return 1
    }
  done
  for flag in --dangerously-skip-permissions --model --effort --output-format --print-timeout; do
    grep -q -- "$flag" <<<"$antigravity_help" || {
      printf 'error: installed Antigravity CLI lacks required %s support\n' "$flag" >&2
      return 1
    }
  done

  printf 'claude_install=verified\n'
  printf 'claude_version=%s\n' "$claude_version"
  printf 'claude_full_delegate=available\n'
  printf 'claude_delegate_model=%s\n' "$claude_delegate_model"
  printf 'claude_delegate_effort=%s\n' "$claude_delegate_effort"
  printf 'antigravity_install=verified\n'
  printf 'antigravity_version=%s\n' "$antigravity_version"
  printf 'antigravity_full_delegate=available\n'
  printf 'antigravity_delegate_model=%s\n' "$antigravity_delegate_model"
  printf 'antigravity_delegate_effort=%s\n' "$antigravity_delegate_effort"
  printf 'authentication_status=not_inspected\n'
}

install_peer_launcher() {
  if [[ -e "$peer_launcher" || -L "$peer_launcher" ]]; then
    [[ -f "$peer_launcher" && ! -L "$peer_launcher" ]] || {
      printf 'error: refusing to replace unexpected peer launcher object: %s\n' "$peer_launcher" >&2
      return 1
    }
  fi
  as_operator install -m 0755 "$peer_source" "$peer_launcher"
}

install_peers() {
  local temporary claude_installer antigravity_installer
  print_plan
  as_operator mkdir -p "$cache_root" "$local_bin"
  temporary=$(as_operator mktemp -d "$cache_root/big-red-agent-peers-install.XXXXXX")
  claude_installer="$temporary/claude-install.sh"
  antigravity_installer="$temporary/antigravity-install.sh"
  cleanup() { as_operator rm -rf "$temporary"; }
  trap cleanup EXIT

  as_operator curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 120 --output "$claude_installer" "$claude_installer_url"
  as_operator curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 120 --output "$antigravity_installer" "$antigravity_installer_url"

  printf 'claude_installer_sha256=%s\n' "$(as_operator sha256sum "$claude_installer" | awk '{print $1}')"
  printf 'antigravity_installer_sha256=%s\n' "$(as_operator sha256sum "$antigravity_installer" | awk '{print $1}')"

  as_operator bash "$claude_installer" stable
  as_operator bash "$antigravity_installer" --skip-path --skip-aliases
  install_peer_launcher
  verify
  cleanup
  trap - EXIT
}

case "$mode" in
  plan) print_plan ;;
  verify) verify ;;
  apply) install_peers ;;
esac
