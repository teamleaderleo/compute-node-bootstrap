#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
operator_user=${SUDO_USER:-leo}
operator_uid=$(id -u "${operator_user}")
operator_home=$(getent passwd "${operator_user}" | cut -d: -f6)
unit_dir=${operator_home}/.config/systemd/user

command -v gdbus >/dev/null 2>&1 || {
  printf 'gdbus is required (Ubuntu package: libglib2.0-bin).\n' >&2
  exit 1
}

sudo install -o root -g root -m 0755 \
  "${script_dir}/big-red-panel-idle-blank" \
  /usr/local/sbin/big-red-panel-idle-blank
sudo install -d -o "${operator_user}" -g "${operator_user}" -m 0755 "${unit_dir}"
sudo install -o "${operator_user}" -g "${operator_user}" -m 0644 \
  "${script_dir}/../systemd/big-red-panel-idle-blank.service" \
  "${unit_dir}/big-red-panel-idle-blank.service"
sudo install -o "${operator_user}" -g "${operator_user}" -m 0644 \
  "${script_dir}/../systemd/big-red-panel-idle-blank.timer" \
  "${unit_dir}/big-red-panel-idle-blank.timer"

user_systemctl() {
  sudo -u "${operator_user}" env \
    XDG_RUNTIME_DIR="/run/user/${operator_uid}" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${operator_uid}/bus" \
    systemctl --user "$@"
}

if [[ -S /run/user/${operator_uid}/bus ]]; then
  user_systemctl daemon-reload
  user_systemctl enable --now big-red-panel-idle-blank.timer
  user_systemctl start big-red-panel-idle-blank.service
else
  # Preserve the enablement for the next login even when this recovery script
  # is run from a console with no active graphical user bus.
  sudo install -d -o "${operator_user}" -g "${operator_user}" -m 0755 \
    "${unit_dir}/timers.target.wants"
  sudo ln -sfn ../big-red-panel-idle-blank.timer \
    "${unit_dir}/timers.target.wants/big-red-panel-idle-blank.timer"
fi
