#!/usr/bin/env bash
set -euo pipefail

projects_root=${BIG_RED_CODEX_MOBILE_PROJECTS_ROOT:-"$HOME/Projects"}

valid_repository_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != . && $1 != .. ]]
}

choose_model() {
  while true; do
    clear
    printf '%s\n' \
      'Big Red Codex' \
      '' \
      'Choose the Codex model:' \
      '  1) Muse Spark 1.3 Contributor Free — X High' \
      '  2) Muse Spark 1.3 Contributor Free — High' \
      '  3) Sol — existing default' \
      '  q) Quit' \
      ''
    read -r -p 'Selection [1]: ' choice || exit 0
    case "${choice:-1}" in
      1) profile=muse-xhigh; model_label=muse-xhigh; return ;;
      2) profile=muse-high; model_label=muse-high; return ;;
      3) profile=; model_label=sol; return ;;
      q|Q) exit 0 ;;
      *) printf 'Choose 1, 2, 3, or q.\n'; sleep 1 ;;
    esac
  done
}

choose_repository() {
  while true; do
    printf '\nRepository under %s [leo-workspace]: ' "$projects_root"
    read -r repository || exit 0
    repository=${repository:-leo-workspace}
    if ! valid_repository_name "$repository"; then
      printf 'Use one top-level repository name, such as glaeda or leo-workspace.\n'
      continue
    fi
    repository_path="$projects_root/$repository"
    if [[ ! -d $repository_path ]] || ! git -C "$repository_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf '%s is not an existing Git repository under %s.\n' "$repository" "$projects_root"
      continue
    fi
    return
  done
}

while true; do
  choose_model
  choose_repository
  session_name="codex-${model_label}-${repository}"
  session_name=${session_name:0:80}
  printf '\nStarting or reattaching %s in %s...\n' "$model_label" "$repository_path"
  if [[ -n $profile ]]; then
    tmux new-session -A -s "$session_name" -c "$repository_path" codex -p "$profile"
  else
    tmux new-session -A -s "$session_name" -c "$repository_path" codex
  fi
done
