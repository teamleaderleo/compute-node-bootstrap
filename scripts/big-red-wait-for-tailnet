#!/usr/bin/env bash
# Block until Tailscale actually holds an IPv4 address, or give up.
#
# tailscaled.service going active is not the same as the tailnet being usable:
# the daemon reports state NoState for a moment while it brings the interface
# up. Units that need a Tailscale address must wait for the address, not for
# the daemon. Ordering alone cannot express that.
set -euo pipefail

deadline=$((SECONDS + ${1:-60}))
until address=$(/usr/bin/tailscale ip -4 2>/dev/null) && [[ -n $address ]]; do
  if (( SECONDS >= deadline )); then
    echo "No Tailscale IPv4 after ${1:-60}s; state: $(/usr/bin/tailscale status --json 2>/dev/null |
      sed -n 's/.*"BackendState": *"\([^"]*\)".*/\1/p' | head -1)" >&2
    exit 1
  fi
  sleep 1
done
echo "Tailscale IPv4 ready: ${address%%$'\n'*}"
