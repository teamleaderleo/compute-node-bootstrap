#!/bin/sh
set -u

dns_class() {
    address=$(getent ahostsv4 "$1" 2>/dev/null | awk 'NR == 1 {print $1}')
    case "$address" in
        198.18.*|198.19.*) printf 'fake-ip\n' ;;
        '') printf 'unresolved\n' ;;
        *) printf 'real\n' ;;
    esac
}

ping_class() {
    output=$(tailscale ping -c 1 --timeout=4s "$1" 2>&1) || {
        printf 'unreachable\n'
        return
    }
    case "$output" in
        *'via DERP('*|*'via relay'*) printf 'relay\n' ;;
        *) printf 'direct\n' ;;
    esac
}

gsettings_scalar() {
    value=$(gsettings get "$1" "$2" 2>/dev/null) || {
        printf 'unavailable\n'
        return
    }
    case "$value" in
        uint32\ *) printf '%s\n' "${value#uint32 }" ;;
        \'*\')
            value=${value#\'}
            printf '%s\n' "${value%\'}"
            ;;
        '') printf 'unavailable\n' ;;
        *) printf '%s\n' "$value" ;;
    esac
}

logind_value() {
    systemd-analyze cat-config systemd/logind.conf 2>/dev/null | awk -F= -v key="$1" '
        {
            name=$1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
        }
        name == key {
            value=$2
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        }
        END {
            if (value == "") value="default"
            print value
        }
    '
}

hwmon_metric() {
    expected_name=$1
    expected_label=$2
    metric_suffix=$3

    for hwmon_directory in /sys/class/hwmon/hwmon*; do
        [ -r "$hwmon_directory/name" ] || continue
        [ "$(cat "$hwmon_directory/name")" = "$expected_name" ] || continue
        for label_path in "$hwmon_directory"/temp*_label; do
            [ -r "$label_path" ] || continue
            [ "$(cat "$label_path")" = "$expected_label" ] || continue
            metric_path=${label_path%_label}_$metric_suffix
            if [ -r "$metric_path" ]; then
                cat "$metric_path"
                return
            fi
        done
    done
    printf 'unavailable\n'
}

child_hwmon_metric() {
    hwmon_parent=$1
    expected_label=$2
    metric_suffix=$3

    for hwmon_directory in "$hwmon_parent"/hwmon*; do
        [ -d "$hwmon_directory" ] || continue
        for label_path in "$hwmon_directory"/temp*_label; do
            [ -r "$label_path" ] || continue
            [ "$(cat "$label_path")" = "$expected_label" ] || continue
            metric_path=${label_path%_label}_$metric_suffix
            if [ -r "$metric_path" ]; then
                cat "$metric_path"
                return
            fi
        done
    done
    printf 'unavailable\n'
}

codex_remote_control_pids() {
    pgrep -u "$(id -u)" -f \
        '^[^[:space:]]*/codex app-server --remote-control --listen unix://$' \
        2>/dev/null || true
}

codex_local_control_socket_state() {
    expected_pid=${1:-}
    socket=${HOME:-}/.codex/app-server-control/app-server-control.sock
    if [ ! -S "$socket" ]; then
        printf 'absent\n'
    elif [ -n "$expected_pid" ] && ss -xlnpH 2>/dev/null | awk \
        -v socket="$socket" -v owner="pid=$expected_pid," '
        index($0, socket) && index($0, owner) { listening = 1 }
        END { exit !listening }
    '; then
        printf 'listening_owned\n'
    elif ss -xlnH 2>/dev/null | awk -v socket="$socket" '
        index($0, socket) { listening = 1 }
        END { exit !listening }
    '; then
        printf 'listening_owner_unverified\n'
    else
        printf 'present_not_listening\n'
    fi
}

printf 'timestamp=%s\n' "$(date --iso-8601=seconds)"
printf 'hostname=%s\n' "$(hostname)"
if ip -4 -brief address show wlp0s20f3 2>/dev/null | awk 'NF >= 3 {found = 1} END {exit !found}' ; then
    printf 'wifi_ipv4=present\n'
else
    printf 'wifi_ipv4=absent\n'
fi

printf '\nCore services:\n'
for unit in NetworkManager ssh tailscaled avahi-daemon chrony; do
    printf '%s=%s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
done
printf 'system_failed_units=%s\n' "$(systemctl --failed --no-legend --plain 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
printf 'user_failed_units=%s\n' "$(systemctl --user --failed --no-legend --plain 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
printf 'network_connectivity=%s\n' "$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)"

printf '\nSleep invariants:\n'
for target in sleep.target suspend.target hibernate.target hybrid-sleep.target; do
    printf '%s=%s\n' "$target" "$(systemctl is-enabled "$target" 2>/dev/null || true)"
done

printf '\nDesktop and lid power:\n'
printf 'screen_idle_delay_seconds=%s\n' "$(gsettings_scalar org.gnome.desktop.session idle-delay)"
printf 'screen_ambient_brightness_enabled=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power ambient-enabled)"
printf 'screen_idle_dim=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power idle-dim)"
printf 'screen_idle_brightness_percent=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power idle-brightness)"
printf 'screen_lock_enabled=%s\n' "$(gsettings_scalar org.gnome.desktop.screensaver lock-enabled)"
printf 'idle_suspend_ac_timeout_seconds=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout)"
printf 'idle_suspend_ac_action=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type)"
printf 'idle_suspend_battery_timeout_seconds=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout)"
printf 'idle_suspend_battery_action=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type)"
printf 'power_button_action=%s\n' "$(gsettings_scalar org.gnome.settings-daemon.plugins.power power-button-action)"
printf 'lid_switch_action=%s\n' "$(logind_value HandleLidSwitch)"
printf 'lid_switch_external_power_action=%s\n' "$(logind_value HandleLidSwitchExternalPower)"
printf 'lid_switch_docked_action=%s\n' "$(logind_value HandleLidSwitchDocked)"
printf 'logind_idle_action=%s\n' "$(logind_value IdleAction)"
backlight=/sys/class/backlight/intel_backlight
if [ -r "$backlight/brightness" ] && [ -r "$backlight/max_brightness" ]; then
    printf 'panel_backlight_raw=%s\n' "$(cat "$backlight/brightness")"
    printf 'panel_backlight_max=%s\n' "$(cat "$backlight/max_brightness")"
fi

printf '\nTailscale summary:\n'
if tailscale status --json 2>/dev/null | jq -r '
    "backend=" + (.BackendState // "unknown"),
    "self_online=" + ((.Self.Online // false) | tostring),
    "exit_node_option=" + ((.Self.ExitNodeOption // false) | tostring),
    "online_peers=" + ([.Peer[]? | select(.Online == true)] | length | tostring)
' 2>/dev/null; then
    :
else
    printf 'status=unavailable\n'
fi
printf 'beryl_path=%s\n' "$(ping_class gl-mt3600be)"
printf 'macbook_path=%s\n' "$(ping_class leos-macbook-air)"

printf '\nBeryl local health:\n'
# The single-quoted script must expand on Beryl, not on Big Red.
# shellcheck disable=SC2016
if router_health=$(timeout 7s ssh \
    -o BatchMode=yes \
    -o PasswordAuthentication=no \
    -o KbdInteractiveAuthentication=no \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=3 \
    -o ConnectionAttempts=1 \
    -o LogLevel=ERROR \
    beryl7 '
service_state() {
    state=$(/etc/init.d/"$1" status 2>/dev/null)
    if [ -n "$state" ]; then
        printf "%s\n" "$state"
    else
        printf "unknown\n"
    fi
}

process_count() {
    pidof "$1" 2>/dev/null | wc -w | tr -d " "
}

process_rss_kib() {
    name=$1
    set -- $(pidof "$name" 2>/dev/null)
    pid=${1:-}
    if [ -n "$pid" ] && [ -r "/proc/$pid/status" ]; then
        rss=$(sed -n "s/^VmRSS:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p" "/proc/$pid/status")
        printf "%s\n" "${rss:-0}"
    else
        printf "0\n"
    fi
}

printf "router_tailscale_service=%s\n" "$(service_state tailscale)"
printf "router_openclash_service=%s\n" "$(service_state openclash)"
printf "router_netifyd_service=%s\n" "$(service_state netifyd)"
printf "router_tailscaled_processes=%s\n" "$(process_count tailscaled)"
printf "router_clash_processes=%s\n" "$(process_count clash)"
printf "router_netifyd_processes=%s\n" "$(process_count netifyd)"
printf "router_tailscaled_rss_kib=%s\n" "$(process_rss_kib tailscaled)"
printf "router_clash_rss_kib=%s\n" "$(process_rss_kib clash)"
printf "router_mem_available_kib=%s\n" "$(sed -n "s/^MemAvailable:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p" /proc/meminfo)"
router_uptime_seconds=$(awk "{print int(\$1)}" /proc/uptime 2>/dev/null)
printf "router_uptime_seconds=%s\n" "${router_uptime_seconds:-unknown}"
logread 2>/dev/null | awk -v uptime="$router_uptime_seconds" "
/Out of memory: Killed process/ {
    count++
    latest=\$0
}
END {
    age=\"not_observed\"
    if (count > 0) {
        marker=latest
        sub(/^.*\\[/, \"\", marker)
        sub(/\\..*$/, \"\", marker)
        # sub() leaves marker string-typed in some awk implementations.
        if (marker ~ /^[0-9]+$/ && uptime ~ /^[0-9]+$/ &&
            uptime + 0 >= marker + 0) {
            age=(uptime + 0)-(marker + 0)
        } else {
            age=\"unknown\"
        }
    }
    printf \"router_oom_kills_current_boot=%d\\n\", count + 0
    printf \"router_latest_oom_age_seconds=%s\\n\", age
}"
printf "router_soc_temp_millic=%s\n" "$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true)"
' 2>/dev/null); then
    printf 'router_ssh=available\n'
    printf '%s\n' "$router_health"
else
    printf 'router_ssh=unavailable\n'
fi

printf '\nDNS interception classification:\n'
for name in controlplane.tailscale.com log.tailscale.com 1.ntp.ubuntu.com ntp-bootstrap.ubuntu.com; do
    printf '%s=%s\n' "$name" "$(dns_class "$name")"
done

printf '\nTime synchronization:\n'
if tracking=$(chronyc tracking 2>/dev/null); then
    printf 'leap_status=%s\n' "$(printf '%s\n' "$tracking" | awk -F': ' '/^Leap status/ {print $2}')"
    printf 'stratum=%s\n' "$(printf '%s\n' "$tracking" | awk -F': ' '/^Stratum/ {print $2}')"
else
    printf 'chrony_tracking=unavailable\n'
fi

printf '\nCapacity, thermals and power:\n'
printf 'root_used=%s\n' "$(df --output=pcent / 2>/dev/null | awk 'NR == 2 {gsub(/[[:space:]]/, ""); print}')"
printf 'journal=%s\n' "$(journalctl --disk-usage 2>/dev/null | sed 's/^Archived and active journals take up //')"
printf 'power_profile=%s\n' "$(powerprofilesctl get 2>/dev/null || true)"
printf 'cpu_package_temperature_millic=%s\n' "$(hwmon_metric coretemp 'Package id 0' input)"
printf 'cpu_package_critical_millic=%s\n' "$(hwmon_metric coretemp 'Package id 0' crit)"

root_source=$(findmnt -n -o SOURCE / 2>/dev/null || true)
nvme_controller=$(printf '%s\n' "$root_source" | sed -n \
    's#^\(/dev/nvme[0-9][0-9]*\)n[0-9][0-9]*\(p[0-9][0-9]*\)\{0,1\}$#\1#p')
nvme_controller_name=${nvme_controller#/dev/}
root_nvme_hwmon=/sys/class/nvme/$nvme_controller_name
printf 'nvme_composite_temperature_millic=%s\n' \
    "$(child_hwmon_metric "$root_nvme_hwmon" Composite input)"
printf 'nvme_composite_critical_millic=%s\n' \
    "$(child_hwmon_metric "$root_nvme_hwmon" Composite crit)"
if [ -n "$nvme_controller" ] && command -v nvme >/dev/null 2>&1 && \
    nvme_smart=$(timeout 5s sudo -n nvme smart-log "$nvme_controller" \
        --output-format=json 2>/dev/null) && \
    printf '%s\n' "$nvme_smart" | jq -e '
        (.critical_warning | type) == "number" and
        (.avail_spare | type) == "number" and
        (.spare_thresh | type) == "number" and
        (.percent_used | type) == "number" and
        (.media_errors | type) == "number" and
        (.num_err_log_entries | type) == "number" and
        (.unsafe_shutdowns | type) == "number" and
        (.warning_temp_time | type) == "number" and
        (.critical_comp_time | type) == "number"
    ' >/dev/null 2>&1; then
    printf 'nvme_smart=available\n'
    printf '%s\n' "$nvme_smart" | jq -r '
        "nvme_critical_warning=" + (.critical_warning | tostring),
        "nvme_available_spare_percent=" + (.avail_spare | tostring),
        "nvme_spare_threshold_percent=" + (.spare_thresh | tostring),
        "nvme_percentage_used=" + (.percent_used | tostring),
        "nvme_media_errors=" + (.media_errors | tostring),
        "nvme_error_log_entries=" + (.num_err_log_entries | tostring),
        "nvme_unsafe_shutdowns=" + (.unsafe_shutdowns | tostring),
        "nvme_warning_temperature_time_minutes=" + (.warning_temp_time | tostring),
        "nvme_critical_temperature_time_minutes=" + (.critical_comp_time | tostring)
    '
else
    printf 'nvme_smart=unavailable\n'
fi
battery=/sys/class/power_supply/BAT0
if [ -r "$battery/status" ]; then
    printf 'battery_status=%s\n' "$(cat "$battery/status")"
    printf 'battery_capacity_percent=%s\n' "$(cat "$battery/capacity" 2>/dev/null || true)"
fi

printf '\nBluetooth summary:\n'
printf 'discovering=%s\n' "$(busctl get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Discovering 2>/dev/null | awk '{print $2}')"
printf 'zero_address_errors_last_hour=%s\n' "$(journalctl -u bluetooth.service --since '-1 hour' -p err --no-pager 2>/dev/null | awk '/00:00:00:00:00:00/ {count++} END {print count + 0}')"

printf '\nChatGPT remote host:\n'
printf 'user_service_enabled=%s\n' "$(systemctl --user is-enabled chatgpt-remote-host.service 2>/dev/null || true)"
printf 'user_service=%s\n' "$(systemctl --user is-active chatgpt-remote-host.service 2>/dev/null || true)"
printf 'graphical_session=%s\n' "$(systemctl --user is-active graphical-session.target 2>/dev/null || true)"
if pgrep -f '^/usr/lib/chatgpt/ChatGPT$' >/dev/null 2>&1; then
    printf 'desktop_process=active\n'
else
    printf 'desktop_process=inactive\n'
fi
remote_control_pids=$(codex_remote_control_pids)
remote_control_processes=$(printf '%s\n' "$remote_control_pids" | awk 'NF { count++ } END { print count + 0 }')
remote_control_pid=$(printf '%s\n' "$remote_control_pids" | awk 'NF { print; exit }')
local_control_socket=$(codex_local_control_socket_state "$remote_control_pid")
printf 'remote_control_processes=%s\n' "$remote_control_processes"
printf 'local_control_socket=%s\n' "$local_control_socket"
if [ "$remote_control_processes" = 1 ] && [ "$local_control_socket" = listening_owned ]; then
    printf 'local_remote_control_transport=ready\n'
else
    printf 'local_remote_control_transport=not_ready\n'
fi
