#!/usr/bin/env bash
set -euo pipefail

mode=apply
operator_user=${SUDO_USER:-leo}
version=0.44.0
asset="jj-v${version}-x86_64-unknown-linux-musl.tar.gz"
archive_sha256=0a07bab4641a55fd2bc2fd1563ba3a3f9a577584086ad74086a1c5b69b3ffce9
asset_url="https://github.com/jj-vcs/jj/releases/download/v${version}/${asset}"
minimum_git_version=2.41.0

usage() {
  cat <<'USAGE'
Usage: install-big-red-jj [--plan|--verify-only|--remove] [--operator-user USER]

Install the pinned Jujutsu release for Big Red's remote-operator experiments.
--plan and --verify-only never mutate state. --remove removes only the managed
launcher and exact pinned installation directory.
USAGE
}

while (($#)); do
  case "$1" in
    --plan)
      mode=plan
      shift
      ;;
    --verify-only)
      mode=verify
      shift
      ;;
    --remove)
      mode=remove
      shift
      ;;
    --operator-user)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      operator_user=$2
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

operator_home=$(getent passwd "$operator_user" | cut -d: -f6 || true)
[[ -n "$operator_home" && -d "$operator_home" ]] || {
  printf 'error: operator user %s has no existing home directory\n' "$operator_user" >&2
  exit 1
}

install_root="$operator_home/.local/lib/big-red-tools/jj/v${version}"
managed_binary="$install_root/jj"
launcher_dir="$operator_home/.local/bin"
launcher="$launcher_dir/jj"
cache_root="$operator_home/.cache"

as_operator() {
  if [[ $(id -un) == "$operator_user" ]]; then
    env HOME="$operator_home" XDG_CONFIG_HOME="$operator_home/.config" "$@"
  else
    command -v sudo >/dev/null || {
      printf 'error: sudo is required to act as operator user %s\n' "$operator_user" >&2
      return 1
    }
    sudo -u "$operator_user" env \
      HOME="$operator_home" \
      XDG_CONFIG_HOME="$operator_home/.config" \
      "$@"
  fi
}

require_host_tools() {
  local tool
  for tool in git dpkg curl sha256sum tar find readlink; do
    command -v "$tool" >/dev/null || {
      printf 'error: required host tool is missing: %s\n' "$tool" >&2
      return 1
    }
  done
}

check_git_version() {
  local git_version
  git_version=$(git --version | awk '{print $3}')
  if ! dpkg --compare-versions "$git_version" ge "$minimum_git_version"; then
    printf 'error: jj %s requires Git >= %s; observed %s\n' \
      "$version" "$minimum_git_version" "$git_version" >&2
    return 1
  fi
  printf '%s' "$git_version"
}

print_plan() {
  local git_version
  require_host_tools
  git_version=$(check_git_version)
  printf 'operator_user=%s\n' "$operator_user"
  printf 'jj_version=%s\n' "$version"
  printf 'git_version=%s\n' "$git_version"
  printf 'asset=%s\n' "$asset"
  printf 'asset_sha256=%s\n' "$archive_sha256"
  printf 'install_relative=.local/lib/big-red-tools/jj/v%s/jj\n' "$version"
  printf 'launcher_relative=.local/bin/jj\n'
}

verify() {
  local git_version version_output binary_sha
  require_host_tools
  git_version=$(check_git_version)

  [[ -f "$managed_binary" && ! -L "$managed_binary" && -x "$managed_binary" ]] || {
    printf 'error: managed jj binary is missing or invalid\n' >&2
    return 1
  }
  [[ -L "$launcher" ]] || {
    printf 'error: managed jj launcher is missing or is not a symlink\n' >&2
    return 1
  }
  [[ $(readlink -f "$launcher") == "$managed_binary" ]] || {
    printf 'error: jj launcher does not resolve to the pinned managed binary\n' >&2
    return 1
  }

  version_output=$(as_operator "$launcher" --version)
  [[ "$version_output" == "jj $version"* ]] || {
    printf 'error: jj version mismatch: expected=%s observed=%s\n' \
      "$version" "$version_output" >&2
    return 1
  }
  binary_sha=$(sha256sum "$managed_binary" | awk '{print $1}')

  printf 'jj_version=%s\n' "$version"
  printf 'git_version=%s\n' "$git_version"
  printf 'jj_binary_sha256=%s\n' "$binary_sha"
  printf 'jj_source_asset_sha256=%s\n' "$archive_sha256"
  printf 'jj_install=verified\n'
}

validate_archive_members() {
  local entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    case "$entry" in
      /*|../*|*/../*|*/..)
        printf 'error: unsafe archive member: %s\n' "$entry" >&2
        return 1
        ;;
    esac
  done < <(tar -tzf "$1")
}

apply_install() {
  local temporary archive extract candidate_count candidate
  local -a candidates

  print_plan

  if [[ -e "$launcher" || -L "$launcher" ]]; then
    if [[ -L "$launcher" && -f "$managed_binary" && $(readlink -f "$launcher") == "$managed_binary" ]]; then
      verify
      return
    fi
    printf 'error: refusing to replace existing launcher: %s\n' "$launcher" >&2
    return 1
  fi
  if [[ -e "$install_root" || -L "$install_root" ]]; then
    printf 'error: refusing pre-existing managed install root: %s\n' "$install_root" >&2
    return 1
  fi

  as_operator install -d -m 0755 "$cache_root" "$launcher_dir" "$(dirname "$install_root")"
  temporary=$(as_operator mktemp -d "$cache_root/big-red-jj-install.XXXXXX")
  trap 'as_operator rm -rf "$temporary"' RETURN
  archive="$temporary/$asset"
  extract="$temporary/extract"

  as_operator curl \
    --fail --location --silent --show-error \
    --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 120 \
    --output "$archive" "$asset_url"

  printf '%s  %s\n' "$archive_sha256" "$archive" | sha256sum -c - >/dev/null
  validate_archive_members "$archive"
  as_operator install -d -m 0700 "$extract"
  as_operator tar -xzf "$archive" -C "$extract"

  mapfile -t candidates < <(find "$extract" -type f -name jj -print)
  candidate_count=${#candidates[@]}
  [[ "$candidate_count" -eq 1 ]] || {
    printf 'error: expected exactly one jj binary in release archive; found %s\n' \
      "$candidate_count" >&2
    return 1
  }
  candidate=${candidates[0]}

  as_operator install -d -m 0755 "$install_root"
  as_operator install -m 0755 "$candidate" "$managed_binary"
  as_operator ln -s "$managed_binary" "$launcher"

  verify
}

remove_install() {
  if [[ -e "$launcher" || -L "$launcher" ]]; then
    [[ -L "$launcher" ]] || {
      printf 'error: refusing to remove non-symlink jj launcher\n' >&2
      return 1
    }
    [[ $(readlink -f "$launcher") == "$managed_binary" ]] || {
      printf 'error: refusing launcher that does not point at the managed jj binary\n' >&2
      return 1
    }
    as_operator rm "$launcher"
  fi

  if [[ -e "$install_root" || -L "$install_root" ]]; then
    [[ -d "$install_root" && ! -L "$install_root" ]] || {
      printf 'error: refusing unexpected jj install root type\n' >&2
      return 1
    }
    local -a entries
    mapfile -t entries < <(find "$install_root" -mindepth 1 -maxdepth 1 -printf '%f\n')
    if ((${#entries[@]} > 1)) || ((${#entries[@]} == 1)) && [[ ${entries[0]} != jj ]]; then
      printf 'error: refusing jj install root with unexpected contents\n' >&2
      return 1
    fi
    [[ ! -e "$managed_binary" || ( -f "$managed_binary" && ! -L "$managed_binary" ) ]] || {
      printf 'error: refusing unexpected managed jj binary type\n' >&2
      return 1
    }
    [[ ! -e "$managed_binary" ]] || as_operator rm "$managed_binary"
    as_operator rmdir "$install_root"
  fi

  printf 'jj_install=removed\n'
}

case "$mode" in
  plan)
    print_plan
    ;;
  verify)
    verify
    ;;
  apply)
    apply_install
    ;;
  remove)
    remove_install
    ;;
esac
