#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  big-red-agent-peer auth claude
  big-red-agent-peer auth antigravity
  big-red-agent-peer review claude [--] [PROMPT...]
  big-red-agent-peer review antigravity [--] [PROMPT...]
  big-red-agent-peer work claude [--] [PROMPT...]
  big-red-agent-peer work antigravity [--] [PROMPT...]
  big-red-agent-peer run claude [--] [PROMPT...]
  big-red-agent-peer run antigravity [--] [PROMPT...]

If PROMPT is omitted, read it from stdin.

review/work/run all launch the provider as a full local coding agent. The mode
changes only the instruction prefix; it does not remove tools, sandbox commands,
or disable normal provider/project configuration.

Codex/Pi can therefore delegate substantial implementation, tests, research,
and review work to either subscription-backed peer.
USAGE
}

[[ $# -ge 2 ]] || { usage >&2; exit 2; }
mode=$1
provider=$2
shift 2
if [[ ${1:-} == -- ]]; then
  shift
fi

case "$mode" in
  auth|review|work|run) ;;
  *) usage >&2; exit 2 ;;
esac
case "$provider" in
  claude|antigravity) ;;
  *) usage >&2; exit 2 ;;
esac

home=${HOME:?HOME is required}
local_bin="$home/.local/bin"
claude="$local_bin/claude"
antigravity="$local_bin/agy"
run_timeout=${BIG_RED_AGENT_TIMEOUT:-90m}
claude_effort=${BIG_RED_CLAUDE_EFFORT:-max}
antigravity_effort=${BIG_RED_ANTIGRAVITY_EFFORT:-high}

require_provider() {
  local label=$1
  local path=$2
  [[ -x "$path" && ! -d "$path" ]] || {
    printf 'error: %s is not installed at %s\n' "$label" "$path" >&2
    return 1
  }
}

read_prompt() {
  if (($#)); then
    printf '%s' "$*"
  else
    cat
  fi
}

project_root() {
  local top
  top=$(/usr/bin/git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || {
    printf 'error: delegated peer work must start inside a Git worktree\n' >&2
    return 1
  }
  top=$(readlink -f "$top")
  [[ -d "$top" && ! -L "$top" && -O "$top" ]] || {
    printf 'error: delegated peer worktree root is not one owner directory\n' >&2
    return 1
  }
  printf '%s' "$top"
}

# Force the subscription-backed login route instead of silently switching to an
# API-key billing path inherited from the calling process. Everything else in
# the normal user environment remains available: PATH/toolchains, GitHub/SSH
# credentials, provider settings, hooks, plugins, skills, MCP servers, and the
# provider's ordinary local configuration.
run_subscription_env() {
  /usr/bin/env \
    -u ANTHROPIC_API_KEY \
    -u ANTHROPIC_AUTH_TOKEN \
    -u CLAUDE_CODE_OAUTH_TOKEN \
    -u GEMINI_API_KEY \
    -u GOOGLE_API_KEY \
    -u GOOGLE_APPLICATION_CREDENTIALS \
    -u GOOGLE_GEMINI_BASE_URL \
    -u OPENAI_API_KEY \
    "$@"
}

prefix_prompt() {
  local selected_mode=$1
  local prompt=$2
  case "$selected_mode" in
    review)
      printf '%s' "Act as an independent senior reviewer. Use the full local agent toolset as useful: inspect the repository, run commands and tests, use configured web/MCP/plugins/skills, and investigate deeply. The main goal is review, but if a concrete fix is useful you may make it and explain the diff. $prompt"
      ;;
    work)
      printf '%s' "Take ownership of this delegated coding task. Use the full local agent toolset, including commands, tests, configured web/MCP/plugins/skills, and file edits. Drive it to a concrete result and report what you changed and verified. $prompt"
      ;;
    run)
      printf '%s' "$prompt"
      ;;
  esac
}

run_claude() {
  local prompt=$1
  require_provider Claude "$claude"
  local -a args=(
    "$claude"
    --dangerously-skip-permissions
    --effort "$claude_effort"
    --output-format json
  )
  if [[ -n ${BIG_RED_CLAUDE_MODEL:-} ]]; then
    args+=(--model "$BIG_RED_CLAUDE_MODEL")
  fi
  args+=(-p "$prompt")
  run_subscription_env /usr/bin/timeout --foreground "$run_timeout" "${args[@]}"
}

run_antigravity() {
  local prompt=$1
  require_provider Antigravity "$antigravity"
  local -a args=(
    "$antigravity"
    -p "$prompt"
    --output-format json
    --dangerously-skip-permissions
    --effort "$antigravity_effort"
    --print-timeout 60m
  )
  if [[ -n ${BIG_RED_ANTIGRAVITY_MODEL:-} ]]; then
    args+=(--model "$BIG_RED_ANTIGRAVITY_MODEL")
  fi
  run_subscription_env /usr/bin/timeout --foreground "$run_timeout" "${args[@]}"
}

if [[ "$mode" == auth ]]; then
  if (($#)); then
    printf 'error: auth mode accepts no prompt\n' >&2
    exit 2
  fi
  case "$provider" in
    claude)
      require_provider Claude "$claude"
      exec "$claude" auth login
      ;;
    antigravity)
      require_provider Antigravity "$antigravity"
      exec "$antigravity"
      ;;
  esac
fi

root=$(project_root)
prompt=$(read_prompt "$@")
[[ -n "$prompt" ]] || {
  printf 'error: peer prompt is empty\n' >&2
  exit 2
}
prompt=$(prefix_prompt "$mode" "$prompt")
cd "$root"

case "$provider" in
  claude) run_claude "$prompt" ;;
  antigravity) run_antigravity "$prompt" ;;
esac
