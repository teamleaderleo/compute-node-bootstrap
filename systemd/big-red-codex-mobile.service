[Unit]
Description=Big Red Codex mobile terminal (loopback only)
Documentation=https://learn.chatgpt.com/docs/app-server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/ttyd --interface 127.0.0.1 --port 7681 --writable --max-clients 4 %h/.local/bin/big-red-codex-mobile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=default.target
