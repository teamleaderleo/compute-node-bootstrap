# Xiaomi's EC may reset charge care when external power changes. Delegate the
# bounded, model-locked re-arm operation to systemd; never run it in udevd.
ACTION=="change", SUBSYSTEM=="power_supply", KERNEL=="ADP1", ATTR{online}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="big-red-charge-limit-rearm.service"
